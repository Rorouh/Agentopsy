# --- Evidence, cases, reports: NEVER commit (may contain real/personal data) ---
# Anchored to repo root so we don't accidentally block source modules under
# backend/forensia/cases/, backend/forensia/reports/, etc.
/cases/
/evidence/*
!/evidence/.gitkeep
/projects/*
!/projects/.gitkeep
/reports/
*.raw
*.vmdk
*.E01
*.aff4
*.mem
*.dmp
*.dump
*.plaso
*_findings.json
/results/investigations/

# --- Knowledge graph (tools/graph): the readable snapshot (graph.json,
#     GRAPH_REPORT.md, graph.html, forensia-graph.json) IS committed so the project
#     architecture is available on clone / at chat start. Only the machine-specific
#     SHA256 cache is excluded (churny, not portable across machines).
tools/graph/out/**/cache/

# --- Evidence corpus (CTF images: too large / licensed; referenced by URL+SHA-256
#     in docs/agentes/corpus-windows.md, NEVER stored in git). The folder ignore
#     also covers companion artefacts with no dedicated extension rule above,
#     e.g. pagefile.sys and FTK Imager logs.
evidence-corpus/

# --- Secrets / config ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
/build/

# --- Node (web/) ---
node_modules/
web/dist/
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- Claude Code ---
.claude/

