# --- Evidence, cases, reports: NEVER commit (may contain real/personal data) ---
# Anchored to repo root so we don't accidentally block source modules under
# backend/forensia/cases/, backend/forensia/reports/, etc.
/cases/
/evidence/*
!/evidence/.gitkeep
/projects/*
!/projects/.gitkeep
/reports/
*.raw
*.vmdk
*.E01
*.aff4
*.mem
*.dmp
*.dump
*.plaso
*_findings.json
/results/investigations/

# --- Knowledge graph (tools/graph): the readable snapshot (graph.json,
#     GRAPH_REPORT.md, graph.html, forensia-graph.json) IS committed so the project
#     architecture is available on clone / at chat start. Only the machine-specific
#     SHA256 cache is excluded (churny, not portable across machines).
tools/graph/out/**/cache/
# Stray graphify output from running graphify directly on a subfolder (e.g. backend/,
# web/) instead of the tools/graph runner. Never committed; the canonical output is
# tools/graph/out/.
graphify-out/

# --- Evidence corpus (CTF images: too large / licensed; referenced by URL+SHA-256
#     in docs/agentes/corpus-windows.md, NEVER stored in git). The folder ignore
#     also covers companion artefacts with no dedicated extension rule above,
#     e.g. pagefile.sys and FTK Imager logs.
evidence-corpus/

# --- Notas internas de trabajo: NO se publican ---
# Borradores de revisión/objeciones que no son documentación del producto. Se
# quedan en la máquina del equipo; el prefijo INTERNO- las marca a simple vista.
/docs/**/INTERNO-*.md

# --- Secrets / config ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
/build/

# --- Node (web/) ---
node_modules/
web/dist/
*.log

# --- OS ---
.DS_Store
Thumbs.db
# Huérfanos que deja FUSE cuando se reescribe in-place un fichero que aún tiene
# un descriptor abierto (p. ej. editar el repo desde un volumen montado). No son
# contenido del proyecto; se pueden borrar con `find . -name '.fuse_hidden*' -delete`.
.fuse_hidden*

# --- Claude Code ---
.claude/

