# --- Vendored forensic binaries (large; build machine produces them, users get the bundle) ---
vendor/*/
!vendor/CATALOG.md

# --- Evidence, cases, reports: NEVER commit (may contain real/personal data) ---
# Anchored to repo root so we don't accidentally block source modules under
# backend/forensia/cases/, backend/forensia/reports/, etc.
/cases/
/evidence/
/reports/
*.raw
*.vmdk
*.E01
*.aff4
*.mem
*.dmp
*.dump
*.plaso
*_findings.json
/results/investigations/

# --- Evidence corpus (CTF images: too large / licensed; referenced by URL+SHA-256
#     in docs/agentes/corpus-windows.md, NEVER stored in git). The folder ignore
#     also covers companion artefacts with no dedicated extension rule above,
#     e.g. pagefile.sys and FTK Imager logs.
evidence-corpus/

# --- Secrets / config ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
/build/
backend/build/*/         # PyInstaller working output; the spec file itself stays tracked
!backend/build/forensia.spec

# --- Node / Electron ---
node_modules/
desktop/renderer/dist/
desktop/out/
desktop/dist/
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- Claude Code ---
.claude/

