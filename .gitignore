# --- Evidence, cases, reports: NEVER commit (may contain real/personal data) ---
# Anchored to repo root so we don't accidentally block source modules under
# backend/forensia/cases/, backend/forensia/reports/, etc.
/cases/
/evidence/*
!/evidence/.gitkeep
/projects/*
!/projects/.gitkeep
/reports/
*.raw
*.vmdk
*.E01
*.aff4
*.mem
*.dump
*.plaso
*_findings.json

# --- Secrets / config ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
/build/

# --- Node (web/) ---
node_modules/
web/dist/
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- Claude Code ---
.claude/

