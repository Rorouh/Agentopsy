# --- Evidence, cases, reports: NEVER commit (may contain real/personal data) ---
# Anchored to repo root so we don't accidentally block source modules under
# backend/agentopsy/cases/, backend/agentopsy/reports/, etc.
/cases/
/evidence/*
!/evidence/.gitkeep
/projects/*
!/projects/.gitkeep
/reports/
*.raw
*.vmdk
*.E01
*.aff4
*.mem
*.dmp
*.dump
*.plaso
*_findings.json
/results/investigations/

# --- Evidence corpus (CTF images: too large / licensed, NEVER stored in git). The
#     folder ignore also covers companion artefacts with no dedicated extension rule
#     above, e.g. pagefile.sys and FTK Imager logs.
evidence-corpus/

# --- Secrets / config ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.venv-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
/build/

# --- Node (web/) ---
node_modules/
web/dist/
*.log

# --- OS ---
.DS_Store
Thumbs.db
# Huérfanos que deja FUSE cuando se reescribe in-place un fichero que aún tiene
# un descriptor abierto (p. ej. editar el repo desde un volumen montado). No son
# contenido del proyecto; se pueden borrar con `find . -name '.fuse_hidden*' -delete`.
.fuse_hidden*

# --- Claude Code ---
# `.claude/*` (no la barra final): con `.claude/` git ni siquiera desciende al
# directorio y la excepción de abajo no llegaría a aplicarse.
.claude/*
# EXCEPCIÓN: settings.json es la config de EQUIPO del repo, no preferencias
# personales. Lo personal va en .claude/settings.local.json, que sigue ignorado por
# la regla de arriba.
!.claude/settings.json

