# agentopsy-local-fit-llm: ejemplo para correrlo FUERA del compose (desarrollo).
# En el compose estas variables las fija docker-compose.yml.
AGENTOPSY_HOME=/ruta/al/repo/projects
AGENTOPSY_EVIDENCE_DIR=/ruta/al/repo/evidence
# Cómo ven los maletines esas dos carpetas (en el compose: /cases y /evidence).
LOCALFIT_HOME_MALETIN=/cases
LOCALFIT_EVIDENCE_DIR_MALETIN=/evidence
AGENTOPSY_TOOLKIT_UNIX_URL=http://toolkit-unix:8666
AGENTOPSY_TOOLKIT_WINDOWS_URL=http://toolkit-windows:8666
OLLAMA_HOST=http://ollama:11434
LOCALFIT_MODEL=agentopsy-local-q25-3b
LOCALFIT_MEMORIA=estructurada          # estructurada | embeddings
# LOCALFIT_EMBED_MODEL=nomic-embed-text  # solo con LOCALFIT_MEMORIA=embeddings
LOCALFIT_NUM_CTX=4096
LOCALFIT_NUM_PREDICT=400
LOCALFIT_NUM_PREDICT_REVISOR=700
# LOCALFIT_THINK=false                   # modelos con razonamiento (qwen3): acotarlo desde la llamada
LOCALFIT_MAX_PASOS=10
LOCALFIT_MAX_PASOS_ORDEN=3
LOCALFIT_MAX_RONDAS_REVISION=1
# LOCALFIT_SHELL=false                    # true: terminal libre dentro del maletín (ver README)
# LOCALFIT_REPARTO=revisor                # revisor (planifica órdenes) | investigador (libre)
# LOCALFIT_MODEL_REVISOR=agentopsy-q25-7b # otro modelo para el revisor
LOCALFIT_TOOL_TIMEOUT=900
LOCALFIT_PORT=8001

# Observabilidad opcional (LangSmith). Con TRACING=true salen prompts y resúmenes
# de herramientas hacia el endpoint configurado: solo para desarrollo o con
# instancia propia. La clave nunca va en un fichero versionado.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=agentopsy-local-fit-llm
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
