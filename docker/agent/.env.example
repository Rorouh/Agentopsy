# Copia este fichero a .env y ajusta. El orquestador lo carga automáticamente.

# --- Capa de modelos (elige uno) ---
FORENSIA_PROVIDER=claude-agent    # claude-agent | ollama | anthropic | openai
# FORENSIA_MODEL=                 # vacío = modelo por defecto del backend/suscripción

# claude-agent: usa tu SUSCRIPCIÓN Claude (Pro/Max) vía Claude Agent SDK.
#   1) pip install claude-agent-sdk
#   2) ejecuta `claude` y haz /login (o `claude setup-token`)
#   3) NO definas ANTHROPIC_API_KEY (si está, facturaría por API)

# Ollama (local)
OLLAMA_HOST=http://localhost:11434

# Anthropic (cloud) — descomenta si usas este backend
# FORENSIA_PROVIDER=anthropic
# FORENSIA_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (cloud) — descomenta si usas este backend
# FORENSIA_PROVIDER=openai
# FORENSIA_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# --- Maletín (contenedores del docker-compose) ---
FORENSIA_WIN_CONTAINER=forensia-toolkit-windows
FORENSIA_UNIX_CONTAINER=forensia-toolkit-unix

# --- Rutas dentro del contenedor / salida en host ---
FORENSIA_EVIDENCE_ROOT=/evidence
FORENSIA_CASES_ROOT=/cases
FORENSIA_CASES_HOST=./projects

# --- Límites ---
FORENSIA_MAX_STEPS=8
FORENSIA_MAX_TOOL_CHARS=60000
FORENSIA_TOOL_TIMEOUT=600
